(module
  ;; This fixture exercises the import boundary instead of only checking that
  ;; an import object has matching property names.
  (import "napi" "napi_get_last_error_info" (func $last-error (param i32 i32) (result i32)))
  (import "napi" "napi_get_uv_event_loop" (func $uv-loop (param i32 i32) (result i32)))
  (import "napi" "napi_async_destroy" (func $async-destroy (param i32 i32) (result i32)))
  (import "napi" "napi_close_callback_scope" (func $close-scope (param i32 i32) (result i32)))
  (import "napi" "napi_async_init" (func $async-init (param i32 i32 i32 i32) (result i32)))
  (import "napi" "napi_open_callback_scope" (func $open-scope (param i32 i32 i32 i32) (result i32)))
  (import "napi" "napi_is_arraybuffer" (func $is-arraybuffer (param i32 i32 i32) (result i32)))
  (import "env" "uv_async_init" (func $uv-async-init (param i32 i32 i32) (result i32)))
  (import "env" "uv_async_send" (func $uv-async-send (param i32) (result i32)))
  (import "env" "uv_close" (func $uv-close (param i32 i32) (result i32)))
  (import "env" "uv_queue_work" (func $uv-queue-work (param i32 i32 i32 i32) (result i32)))
  (import "env" "emscripten_notify_memory_growth" (func $memory-growth (param i32) (result i32)))

  (memory (export "memory") 1)
  (table (export "__indirect_function_table") 3 funcref)
  (global $heap (mut i32) (i32.const 1024))

  (func (export "napi_wasm_malloc") (param $size i32) (result i32)
    (global.get $heap)
    (global.get $heap)
    (local.get $size)
    (i32.add)
    (global.set $heap))
  (func (export "napi_register_wasm_v1") (param i32 i32))

  (func (export "probe") (param i32 i32 i32) (result i32)
    (call $is-arraybuffer (local.get 0) (local.get 1) (local.get 2)))
  (func (export "exercise_napi") (param $env i32) (param $value i32) (param $result i32) (result i32)
    (drop (call $last-error (local.get $env) (i32.const 32)))
    (drop (call $uv-loop (local.get $env) (i32.const 36)))
    (drop (call $async-init (local.get $env) (i32.const 0) (i32.const 0) (i32.const 40)))
    (drop (call $open-scope (local.get $env) (i32.const 0) (i32.load (i32.const 40)) (i32.const 44)))
    (drop (call $close-scope (local.get $env) (i32.load (i32.const 44))))
    (drop (call $async-destroy (local.get $env) (i32.load (i32.const 40))))
    (call $is-arraybuffer (local.get $env) (local.get $value) (local.get $result)))
  (func (export "probe_last_error") (param i32 i32) (result i32)
    (call $last-error (local.get 0) (local.get 1)))

  (func (export "exercise_env") (param $handle i32) (result i32)
    (drop (call $uv-async-init (i32.const 0) (local.get $handle) (i32.const 0)))
    (drop (call $uv-async-send (local.get $handle)))
    (drop (call $uv-queue-work (i32.const 0) (i32.add (local.get $handle) (i32.const 4)) (i32.const 1) (i32.const 2)))
    (drop (call $uv-close (local.get $handle) (i32.const 0)))
    (drop (call $memory-growth (i32.const 0)))
    (i32.const 0))

  (func $async-callback (param i32)
    (i32.store (i32.const 64) (i32.const 1)))
  (func $work-callback (param i32)
    (i32.store (i32.const 68) (i32.const 1)))
  (func $complete-callback (param i32)
    (i32.store (i32.const 72) (i32.const 1)))
  (elem (i32.const 0) $async-callback $work-callback $complete-callback)
)
